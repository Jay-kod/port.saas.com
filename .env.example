##############################################################################
#  DevFolio.AI — Environment Configuration
#  ─────────────────────────────────────────
#  Copy this file to .env and fill in the values:
#
#     cp .env.example .env
#     php artisan key:generate
#
#  See README.md for full documentation.
##############################################################################

#───────────────────────────────────────────────────────────────────────────────
# Application
#───────────────────────────────────────────────────────────────────────────────
APP_NAME="DevFolio AI"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

#───────────────────────────────────────────────────────────────────────────────
# SaaS Mode
#───────────────────────────────────────────────────────────────────────────────
# false = Self-Hosted / Single-Tenant mode (default).
#         Your portfolio is served at the root URL (/).
#
# true  = Multi-Tenant SaaS mode.
#         Marketing homepage at /, tenant portfolios at /{slug}/...
#         Enables registration, billing, teams, custom domains.
#
# Switching back to false instantly restores single-tenant behavior.
SAAS_MODE=false

#───────────────────────────────────────────────────────────────────────────────
# Security
#───────────────────────────────────────────────────────────────────────────────
BCRYPT_ROUNDS=12

#───────────────────────────────────────────────────────────────────────────────
# Logging
#───────────────────────────────────────────────────────────────────────────────
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

#───────────────────────────────────────────────────────────────────────────────
# Database
#───────────────────────────────────────────────────────────────────────────────
# SQLite (default, zero config — great for local dev and small deployments):
DB_CONNECTION=sqlite

# MySQL / MariaDB (uncomment for production):
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=devfolio
# DB_USERNAME=root
# DB_PASSWORD=

# PostgreSQL (uncomment for production):
# DB_CONNECTION=pgsql
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=devfolio
# DB_USERNAME=postgres
# DB_PASSWORD=

#───────────────────────────────────────────────────────────────────────────────
# Session & Cache
#───────────────────────────────────────────────────────────────────────────────
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

#───────────────────────────────────────────────────────────────────────────────
# Redis (optional — uncomment if using Redis for cache/session/queue)
#───────────────────────────────────────────────────────────────────────────────
# REDIS_CLIENT=phpredis
# REDIS_HOST=127.0.0.1
# REDIS_PASSWORD=null
# REDIS_PORT=6379

#───────────────────────────────────────────────────────────────────────────────
# Mail
#───────────────────────────────────────────────────────────────────────────────
# Default: log (writes emails to storage/logs — great for dev).
# Production: use smtp, ses, mailgun, postmark, etc.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

#───────────────────────────────────────────────────────────────────────────────
# AWS (optional — only needed if using S3 for file storage)
#───────────────────────────────────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

#───────────────────────────────────────────────────────────────────────────────
# Vite (Frontend Build)
#───────────────────────────────────────────────────────────────────────────────
VITE_APP_NAME="${APP_NAME}"

#───────────────────────────────────────────────────────────────────────────────
# Stripe Billing (SaaS Mode Only)
#───────────────────────────────────────────────────────────────────────────────
# Required only when SAAS_MODE=true and you want paid plans.
# Get your keys from https://dashboard.stripe.com/apikeys
#
# 1. Create two Products in Stripe with recurring prices:
#    - "Pro Developer" → copy the price_xxx ID to STRIPE_PRICE_PRO
#    - "Agency / Team" → copy the price_xxx ID to STRIPE_PRICE_AGENCY
#
# 2. Create a Webhook endpoint pointing to:
#    https://yourdomain.com/stripe/webhook
#    Listen for: checkout.session.completed,
#                customer.subscription.updated,
#                customer.subscription.deleted
#    Copy the signing secret to STRIPE_WEBHOOK_SECRET.
#
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_AGENCY=

#───────────────────────────────────────────────────────────────────────────────
# Socialite OAuth Sign-In (GitHub & Google)
#───────────────────────────────────────────────────────────────────────────────
# Free forever. Works locally with http://127.0.0.1:8000!
#
# GitHub Setup (Free):
# 1. Go to https://github.com/settings/developers → OAuth Apps → New OAuth App
# 2. Homepage URL: http://127.0.0.1:8000
# 3. Callback URL: http://127.0.0.1:8000/auth/callback/github
#
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI="${APP_URL}/auth/callback/github"

# Google Setup (Free):
# 1. Go to https://console.cloud.google.com/apis/credentials → Create Credentials → OAuth client ID
# 2. Authorized Redirect URI: http://127.0.0.1:8000/auth/callback/google
#
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/callback/google"

